internal/agentguard/broker TestActivityReportsDeallocAndFallsBack # needs pg_stat_statements.max=100 (SAGE_TEST_PSS_SMALL_URL): ci.yml agent-servers
internal/pgaudit TestRealPGAuditCorrelation # needs pgaudit preloaded and jsonlog: ci.yml agent-servers

