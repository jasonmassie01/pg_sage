internal/collector TestCollectQueries_BlockReadTimeFromStatements # PG16 does not time local-buffer reads in pg_stat_statements
internal/autoexplain TestCaptureOnDemand_(ParameterizedUsesGenericPlan|NormalizedParameterizedQuery) # EXPLAIN (GENERIC_PLAN) is PG16+
internal/optimizer TestGenericPlanCapturesUnboundParameters # EXPLAIN (GENERIC_PLAN) is PG16+
internal/api TestActionLogCappedCountWalksTheTimeIndex # EXPLAIN (GENERIC_PLAN) is PG16+
internal/recommendation TestVerifyingEffectsReachActionsByIndex # EXPLAIN (GENERIC_PLAN) is PG16+
internal/retention TestPurgeGenericPlansProbeLargeTablesByIndex # EXPLAIN (GENERIC_PLAN) is PG16+
internal/retention TestAuthAuditPurge_GenericPlanUsesAnIndex # EXPLAIN (GENERIC_PLAN) is PG16+
internal/sre TestInvestigationRetentionReadIsAnIndexRange # EXPLAIN (GENERIC_PLAN) is PG16+
internal/value TestRealizedValueGenericPlanIsAnIndexRange # EXPLAIN (GENERIC_PLAN) is PG16+
internal/earned TestReconcilerFactReadsNeverScanOutcomes # EXPLAIN (GENERIC_PLAN) is PG16+
internal/analyzer TestFindingRefreshIsAHeapOnlyUpdate # pg_stat_force_next_flush() is PG15+
internal/partition TestConvert_ExclusiveWindowReadsNoHeap # pg_stat_force_next_flush() is PG15+
internal/rca TestPersist_UnchangedCausalChainWritesNoToast # pg_stat_force_next_flush() is PG15+
internal/agentposture TestAP03_SecurityInvokerViewIsNotExposure # security_invoker views are PG15+ (PG14 views run as their owner)
internal/agentposture TestAP14_NoInheritGrantIsFine # per-grant INHERIT (GRANT ... WITH INHERIT FALSE) is PG16+; PG14/15 run the role-level arm tests
internal/tuner TestFunctional_Coverage_DB_HintPlanSQLUsesQueryIDSchema|TestHintRemovalFindings_RetiredAndBrokenOnly|TestBuildFinding_EmptyHintIsNeverInserted|TestBuildFinding_ProposalIsNotActive|TestLoadActiveHints_IncludesProposed|TestReconcileHintStatuses_.* # query_id hint table is pg_hint_plan 1.7+ (PG17+)
internal/tuner TestGeneratePlanFixtures # regenerates committed plan fixtures; opt-in PG_SAGE_REGEN_PLAN_FIXTURES=1
test/hint_verify TestHint_HintTableIntegration # query_id hint table is pg_hint_plan 1.7+ (PG17+)

# Agent role management (spec section 6.6) needs PostgreSQL 16+ (CREATEROLE
# no longer implies membership; GRANT ... WITH INHERIT/SET). On PG14/15 Guard is
# posture-only and TestEnsure_RefusedBeforePG16 pins the refusal; it skips on 16+.
internal/agentguard TestEnsure_RefusedBeforePG16 # covers PG14/15 only; the PG16+ legs run the role tests it stands in for
internal/agentguard Test(Ensure|Retire|Unfreeze)_.* # agent role management is PG16+; PG14/15 legs run TestEnsure_RefusedBeforePG16
internal/agentguard TestKill_.* # agent roles (kill, freeze) are PG16+ on PG14/15; the fleet and replica kills run in ci.yml agent-servers
internal/agentguard TestFreeze_Operator|TestFrozen_NoFlags|TestInflight_RegisterAndKillCancels|TestFallback_Reconcile # agent roles are PG16+ (posture-only on PG14/15)
internal/agentguard TestCheckBackends_RegisteredRolePassesThenDrifts # registering an agent role is PG16+ (posture-only on PG14/15)
internal/agentguard/grants Test(Approve|CheckObjects|EffectivePrivileges|ExpireDue|Grant|LeaseActive|List|RegistryPrivileges|RequestCapability|Revoke)_.*|TestGrantNowAndRevokeNow # agent grants need agent roles, PG16+ (posture-only on PG14/15)
internal/agentguard/upkeep TestDrift_.*|TestEndToEnd_(RotationSetsANewPasswordAndSaysItIsScheduled|RetireDropsTheRolesAfterGrace|ObservationWithholdsRotation) # drift, rotation and retire act on agent roles, PG16+ (posture-only on PG14/15)
internal/retention TestGuardQueryAuditPurge_GenericPlanUsesAnIndex # EXPLAIN (GENERIC_PLAN) is PG16+

