# Skips CI accepts. Format: <package-regex> <test-regex> # reason
# Patterns are anchored; the test pattern matches the top-level test name.
# Anything skipped that is not listed here fails the skipbudget gate
# (cmd/skipbudget). Add an entry only with a reason a reviewer can verify.

# Live cloud provisioning: opt-in via PG_SAGE_LIVE_* and real credentials.
internal/agentdb Test(AWSRDS|CloudSQL|Lakebase)LiveProvisioning # live cloud, PG_SAGE_LIVE_* opt-in
internal/agentdb TestAgentDBLiveGauntlet.* # live cloud, PG_SAGE_LIVE_AGENTDB_GAUNTLET opt-in

# Live LLM calls: need a provider key and spend quota.
internal/rca TestTier2Live_.* # live LLM, PG_SAGE_LIVE_LLM=1 opt-in
e2e TestLLM.* # live LLM, SAGE_LLM_API_KEY opt-in
e2e TestTunerLLM_.* # live LLM, SAGE_LLM_API_KEY opt-in
e2e TestOptimizerMultiQueryConsolidation # live LLM, SAGE_LLM_API_KEY opt-in

# Helper subprocesses that only run when a parent test re-executes the binary.
internal/rca TestRCAChildProcessFixture # subprocess helper for TestPreflightRCAProcessRestart*

# OS-specific paths.
internal/logwatch TestResolveLogDir_Absolute(Unix|Windows) # OS path semantics, each skipped on the other OS

# Version-gated features. The PG 14-18 matrix runs each on the versions
# that have it, so a skip here on a supporting version shows up as a pass
# missing from that matrix leg, not as a silent gap.
internal/collector TestCollectIO|TestPhase2_CollectIO_FieldsPopulated # pg_stat_io is PG16+
internal/collector TestCollectQueries_BlockReadTimeFromStatements # PG16 does not time local-buffer reads in pg_stat_statements
internal/autoexplain TestCaptureOnDemand_(ParameterizedUsesGenericPlan|NormalizedParameterizedQuery) # EXPLAIN (GENERIC_PLAN) is PG16+
internal/optimizer TestGenericPlanCapturesUnboundParameters # EXPLAIN (GENERIC_PLAN) is PG16+
internal/tuner TestFunctional_Coverage_DB_HintPlanSQLUsesQueryIDSchema|TestHintRemovalFindings_RetiredAndBrokenOnly # query_id hint table is pg_hint_plan 1.7+ (PG17+)
test/hint_verify TestHint_HintTableIntegration # query_id hint table is pg_hint_plan 1.7+ (PG17+)
