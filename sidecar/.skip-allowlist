# Skips CI accepts. Format: <package-regex> <test-regex> # reason
# Patterns are anchored; the test pattern matches the top-level test name.
# Anything skipped that is not listed here fails the skipbudget gate
# (cmd/skipbudget). Add an entry only with a reason a reviewer can verify.

# Live cloud provisioning: opt-in via PG_SAGE_LIVE_* and real credentials.
internal/azure TestAzureLiveServerParameter # live cloud, PG_SAGE_LIVE_AZURE opt-in
internal/azure TestAzureLiveRestartBoundParameter # live cloud, PG_SAGE_LIVE_AZURE opt-in

# Live LLM calls: need a provider key and spend quota.
internal/rca TestTier2Live_.* # live LLM, PG_SAGE_LIVE_LLM=1 opt-in
internal/llm TestChat(WithTools)?Live_.* # live LLM, PG_SAGE_LIVE_LLM=1 opt-in
e2e TestLLM.* # live LLM, SAGE_LLM_API_KEY opt-in
e2e TestTuningAgentLive # live LLM, PG_SAGE_LIVE_LLM=1 and SAGE_LLM_API_KEY opt-in

# Helper subprocesses that only run when a parent test re-executes the binary.
internal/rca TestRCAChildProcessFixture # subprocess helper for TestPreflightRCAProcessRestart*

# OS-specific paths.
internal/logwatch TestResolveLogDir_Absolute(Unix|Windows) # OS path semantics, each skipped on the other OS

# Version-gated features. The PG 14-18 matrix runs each on the versions
# that have it, so a skip here on a supporting version shows up as a pass
# missing from that matrix leg, not as a silent gap.
internal/collector TestCollectIO|TestPhase2_CollectIO_FieldsPopulated # pg_stat_io is PG16+
internal/collector TestCollectQueries_BlockReadTimeFromStatements # PG16 does not time local-buffer reads in pg_stat_statements
internal/autoexplain TestCaptureOnDemand_(ParameterizedUsesGenericPlan|NormalizedParameterizedQuery) # EXPLAIN (GENERIC_PLAN) is PG16+
internal/optimizer TestGenericPlanCapturesUnboundParameters # EXPLAIN (GENERIC_PLAN) is PG16+
internal/api TestActionLogCappedCountWalksTheTimeIndex # EXPLAIN (GENERIC_PLAN) is PG16+
internal/recommendation TestVerifyingEffectsReachActionsByIndex # EXPLAIN (GENERIC_PLAN) is PG16+
internal/retention TestPurgeGenericPlansProbeLargeTablesByIndex # EXPLAIN (GENERIC_PLAN) is PG16+
internal/sre TestInvestigationRetentionReadIsAnIndexRange # EXPLAIN (GENERIC_PLAN) is PG16+
internal/value TestRealizedValueGenericPlanIsAnIndexRange # EXPLAIN (GENERIC_PLAN) is PG16+
internal/earned TestReconcilerFactReadsNeverScanOutcomes # EXPLAIN (GENERIC_PLAN) is PG16+
internal/analyzer TestFindingRefreshIsAHeapOnlyUpdate # pg_stat_force_next_flush() is PG15+
internal/partition TestConvert_ExclusiveWindowReadsNoHeap # pg_stat_force_next_flush() is PG15+
internal/rca TestPersist_UnchangedCausalChainWritesNoToast # pg_stat_force_next_flush() is PG15+
internal/tuner TestFunctional_Coverage_DB_HintPlanSQLUsesQueryIDSchema|TestHintRemovalFindings_RetiredAndBrokenOnly|TestBuildFinding_EmptyHintIsNeverInserted|TestBuildFinding_ProposalIsNotActive|TestLoadActiveHints_IncludesProposed|TestReconcileHintStatuses_.* # query_id hint table is pg_hint_plan 1.7+ (PG17+)
internal/tuner TestGeneratePlanFixtures # regenerates committed plan fixtures; opt-in PG_SAGE_REGEN_PLAN_FIXTURES=1
test/hint_verify TestHint_HintTableIntegration # query_id hint table is pg_hint_plan 1.7+ (PG17+)

# PGIncidentBench runs in its own CI steps (SAGE_BENCH_RUN=1, sharded by SAGE_BENCH_FAMILIES),
# not inside ./... suites.
sre-bench TestPGIncidentBench # dedicated "PGIncidentBench (...)" CI steps set SAGE_BENCH_RUN=1
sre-bench TestLiveModelArm # nightly live-model arm (ci.yml bench-live) only: SAGE_BENCH_LIVE_ARM=1 + PG_SAGE_LIVE_LLM=1 opt-in
internal/ha TestContainer_FailoverWhileDownOpensTheCooldown # needs a disposable standby to promote (SAGE_TEST_HA_STANDBY_URL)
internal/sre/causal TestContainer_(Restart|Promotion)BetweenSamplesInvalidatesComparisons # restarts/promotes a disposable server (SAGE_TEST_RESTARTABLE_SUPERUSER_URL, SAGE_TEST_CAUSAL_STANDBY_URL)
internal/sre/pooler TestPgBouncer_.* # needs a PgBouncer (SAGE_TEST_PGBOUNCER_ADMIN_URL, SAGE_TEST_PGBOUNCER_CLIENT_URL)
