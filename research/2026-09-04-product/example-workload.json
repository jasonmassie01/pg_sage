{
  "schema": "pgsage_vectorlab_demo",
  "table": "documents",
  "id_column": "id",
  "vector_column": "embedding",
  "filter_columns": ["tenant"],
  "distance": "l2",
  "k": 10,
  "repeats": 3,
  "min_recall": 0.95,
  "max_p95_ms": 50,
  "statement_timeout_ms": 5000,
  "total_timeout_ms": 60000,
  "variants": [
    {"name": "small-off", "ef_search": 10, "iterative_scan": "off"},
    {"name": "balanced-strict", "ef_search": 100, "iterative_scan": "strict_order"},
    {"name": "wide-strict", "ef_search": 200, "iterative_scan": "strict_order"}
  ],
  "queries": [
    {"id": "tenant-a-near", "vector": [17.12, 0.3], "filters": ["1"]},
    {"id": "tenant-b-middle", "vector": [5023.12, 0.3], "filters": ["2"]},
    {"id": "tenant-c-far", "vector": [9008.12, 0.3], "filters": ["3"]}
  ]
}
